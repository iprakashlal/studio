// The Studio helper as a Cloudflare Worker. Deployed with the "Deploy to Cloudflare" button in the
// Studio; the KV namespace below is created for you on the first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-helper",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "HELPER" }],
  // Where the helper page's "Connect to my Studio" button goes. Change it if your Studio runs at another address.
  "vars": { "STUDIO_URL": "https://iprakashlal.github.io/studio/" }
}
