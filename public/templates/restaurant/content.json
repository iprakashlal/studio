  "faq": {
    "eyebrow": "Good to know",
    "title": "Questions guests ask",
    "items": [
      {
        "q": "Do I need a reservation?",
        "a": "Walk-ins are welcome. On Friday and Saturday evenings a booking is the safest way to get a table."
      },
      {
        "q": "Do you have vegan and gluten-free dishes?",
        "a": "Yes. They are marked on the menu, and the kitchen can adapt several others. Please tell your server about any allergy."
      },
      {
        "q": "Is there parking?",
        "a": "There is valet parking in the evening and street parking during the day."
      },
      {
        "q": "Can I bring a cake?",
        "a": "Of course. We'll keep it chilled and bring it out when you're ready. No cakeage fee."
      }
